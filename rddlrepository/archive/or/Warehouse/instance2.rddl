		STORAGE(x1, y4); STORAGE(x2, y4); STORAGE(x4, y4); STORAGE(x5, y4); STORAGE(x7, y4); STORAGE(x8, y4);
		STORAGE(x1, y5); STORAGE(x2, y5); STORAGE(x4, y5); STORAGE(x5, y5); STORAGE(x7, y5); STORAGE(x8, y5);
		STORAGE(x1, y6); STORAGE(x2, y6); STORAGE(x4, y6); STORAGE(x5, y6); STORAGE(x7, y6); STORAGE(x8, y6);
		STORAGE(x1, y7); STORAGE(x2, y7); STORAGE(x4, y7); STORAGE(x5, y7); STORAGE(x7, y7); STORAGE(x8, y7);
		STORAGE(x1, y8); STORAGE(x2, y8); STORAGE(x4, y8); STORAGE(x5, y8); STORAGE(x7, y8); STORAGE(x8, y8);
		STORAGE(x1, y10); STORAGE(x2, y10); STORAGE(x7, y10); STORAGE(x8, y10);
