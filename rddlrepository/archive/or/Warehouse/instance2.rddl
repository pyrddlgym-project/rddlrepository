		STORAGE(x1, y14); STORAGE(x2, y14); STORAGE(x7, y14); STORAGE(x8, y14);
		STORAGE(x1, y15); STORAGE(x2, y15); STORAGE(x7, y15); STORAGE(x8, y15);
		STORAGE(x1, y16); STORAGE(x2, y16); STORAGE(x7, y16); STORAGE(x8, y16);
