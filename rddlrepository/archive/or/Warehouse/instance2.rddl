// The small warehouse of RWARE with 4 robots and 4 requests (rware-small-4ag-v2):
// 20 rows and 10 columns, 80 shelves and 2 workstations, with a random start.

non-fluents warehouse_nf2 {
	domain = warehouse;

	objects {
