		STORAGE(x1, y1); STORAGE(x2, y1); STORAGE(x4, y1); STORAGE(x5, y1); STORAGE(x7, y1); STORAGE(x8, y1);
		STORAGE(x1, y2); STORAGE(x2, y2); STORAGE(x4, y2); STORAGE(x5, y2); STORAGE(x7, y2); STORAGE(x8, y2);
