////////////////////////////////////////////////////////////////////
// A warehouse where robots fetch shelves for the items that are
// requested and carry them to the workstations, with the rules of the
// multi-robot warehouse (RWARE) of Papoudakis et al.
//
// The warehouse is a grid of cells. Columns are counted from the left
// and rows from the top. Shelves stand in the storage cells, and all
// other cells are corridors, some of which are workstations. A robot
// faces up, right, down or left, and each step it waits, moves one
// cell forward, turns left or right on the spot, or toggles its load:
// it lifts the shelf above it if it carries none, or puts down the
// one it carries if it is in a storage cell. Robots without a load
// drive under the standing shelves, and robots with a load may not
// enter a cell with a standing shelf.
//
// Two robots never share a cell. A robot moves forward unless it is
// at the edge of the grid or would carry its shelf into a standing
// one, and unless it is blocked by other robots:
//   1. robots that do not move block robots moving into their cells,
//      and so do the robots blocked by them, and so on down the line;
//   2. robots moving around a loop each into the cell of the next
//      all move, unless there are just two of them swapping cells,
//      in which case neither moves;
//   3. of the lines of robots moving towards the same free cell, only
//      the longest one moves. Where lines join, of two lines of the
//      same length, the one whose robot entering the joining cell is
//      first in reading order (smallest row, then smallest column)
//      goes on.
// A line of robots moves together, each into the cell of the one in
// front of it, and the shelves they carry move with them. RWARE breaks
// the ties in 3 by an order of its own on the robots, and reading
// order on the grid stands in for it here.
//
// A shelf that is requested and is in a workstation cell after the
// step is delivered. It is no longer requested, and as many new
// shelves as were delivered are requested instead, chosen uniformly
// among the shelves that were not requested before the step. The
// reward is the number of shelves delivered. RWARE rewards each robot
// for its own deliveries: their sum is this reward.
//
// RWARE robots only see the cells around them and act on their own.
// Here one controller sees the whole warehouse and gives an order to
// each robot. The rules for robots blocked by others follow lines of
// up to 64 robots, so an instance may have up to 65 robots.
//
// References:
//
//		Georgios Papoudakis, Filippos Christianos, Lukas Schäfer and
//		Stefano V. Albrecht. Benchmarking Multi-Agent Deep Reinforcement
//		Learning Algorithms in Cooperative Tasks. NeurIPS Datasets and
//		Benchmarks, 2021.
//
//		Filippos Christianos, Lukas Schäfer and Stefano V. Albrecht.
//		Shared Experience Actor-Critic for Multi-Agent Reinforcement
//		Learning. NeurIPS, 2020.
//
// Author(s):
//		Mike Gimelfarb (mgimelfarb@yahoo.ca)
//
////////////////////////////////////////////////////////////////////
domain warehouse {

	requirements = {
		reward-deterministic
	};

	types {
		xpos : object;
		ypos : object;
		robot : object;
		shelf : object;
		heading : { @up, @right, @down, @left };
		order : { @wait, @forward, @turn-left, @turn-right, @toggle-load };
	};

	pvariables {

		// the grid
		WIDTH 						: { non-fluent, int, default = 1 };			// number of columns
		HEIGHT 						: { non-fluent, int, default = 1 };			// number of rows
		X(xpos) 					: { non-fluent, int, default = 0 };			// index of a column
		Y(ypos) 					: { non-fluent, int, default = 0 };			// index of a row
		STORAGE(xpos, ypos) 		: { non-fluent, bool, default = false };	// shelves may stand here
		STATION(xpos, ypos) 		: { non-fluent, bool, default = false };	// a workstation

		// where the robots try to go
		loaded(robot) 				: { interm-fluent, bool };					// carries a shelf
		held(shelf) 				: { interm-fluent, bool };					// is carried by a robot
		aim-x(robot) 				: { interm-fluent, int };					// the cell in front, or its own
		aim-y(robot) 				: { interm-fluent, int };
		moving(robot) 				: { interm-fluent, bool };					// tries to change cells
		next(robot, robot) 			: { interm-fluent, bool };					// moves into the cell of the other

		// the robots each robot follows in its line: next robots up to 1, 2, 4, ..., 64 steps on
		reach1(robot, robot) 		: { interm-fluent, bool };
		reach2(robot, robot) 		: { interm-fluent, bool };
		reach4(robot, robot) 		: { interm-fluent, bool };
		reach8(robot, robot) 		: { interm-fluent, bool };
		reach16(robot, robot) 		: { interm-fluent, bool };
		reach32(robot, robot) 		: { interm-fluent, bool };
		reach64(robot, robot) 		: { interm-fluent, bool };

		// which robots move
		loop(robot) 				: { interm-fluent, bool };					// moves around a loop of robots
		swap(robot) 				: { interm-fluent, bool };					// swaps cells with another robot
		length(robot) 				: { interm-fluent, int };					// robots in the longest line up to it
		first(robot) 				: { interm-fluent, bool };					// wins the cell it moves into
		advances(robot) 			: { interm-fluent, bool };

		// after the move
		new-x(robot) 				: { interm-fluent, int };
		new-y(robot) 				: { interm-fluent, int };
		new-shelf-x(shelf) 			: { interm-fluent, int };
		new-shelf-y(shelf) 			: { interm-fluent, int };
		in-storage(robot) 			: { interm-fluent, bool };					// may put down its shelf
		delivered(shelf) 			: { interm-fluent, bool };

		// new requests, for the shelves with the smallest random numbers
		draw(shelf) 				: { interm-fluent, real };
		rank(shelf) 				: { interm-fluent, int };

		// states
		robot-x(robot) 				: { state-fluent, int, default = 0 };
		robot-y(robot) 				: { state-fluent, int, default = 0 };
		facing(robot) 				: { state-fluent, heading, default = @up };
		shelf-x(shelf) 				: { state-fluent, int, default = 0 };
		shelf-y(shelf) 				: { state-fluent, int, default = 0 };
		carrying(robot, shelf) 		: { state-fluent, bool, default = false };
		requested(shelf) 			: { state-fluent, bool, default = false };

		// actions
		command(robot) 				: { action-fluent, order, default = @wait };
	};

	cpfs {

		// where the robots try to go: the cell in front, which must be in the grid, and for a
		// robot with a load, must not hold a standing shelf
		loaded(?r) = (exists_{?s : shelf} [carrying(?r, ?s)]);
		held(?s) = (exists_{?r : robot} [carrying(?r, ?s)]);
		aim-x(?r) = if ((command(?r) == @forward) ^ (facing(?r) == @left)) then max[0, robot-x(?r) - 1]
					else if ((command(?r) == @forward) ^ (facing(?r) == @right)) then min[WIDTH - 1, robot-x(?r) + 1]
					else robot-x(?r);
		aim-y(?r) = if ((command(?r) == @forward) ^ (facing(?r) == @up)) then max[0, robot-y(?r) - 1]
					else if ((command(?r) == @forward) ^ (facing(?r) == @down)) then min[HEIGHT - 1, robot-y(?r) + 1]
					else robot-y(?r);
		moving(?r) = ((aim-x(?r) ~= robot-x(?r)) | (aim-y(?r) ~= robot-y(?r)))
					 ^ ~(loaded(?r) ^ (exists_{?s : shelf} [~held(?s) ^ (shelf-x(?s) == aim-x(?r))
															^ (shelf-y(?s) == aim-y(?r))]));
		next(?r, ?r2) = moving(?r) ^ (robot-x(?r2) == aim-x(?r)) ^ (robot-y(?r2) == aim-y(?r));

		// the lines of robots, by doubling the number of steps followed
		reach1(?r, ?r2) = (?r == ?r2) | next(?r, ?r2);
		reach2(?r, ?r2) = (exists_{?r3 : robot} [reach1(?r, ?r3) ^ reach1(?r3, ?r2)]);
		reach4(?r, ?r2) = (exists_{?r3 : robot} [reach2(?r, ?r3) ^ reach2(?r3, ?r2)]);
		reach8(?r, ?r2) = (exists_{?r3 : robot} [reach4(?r, ?r3) ^ reach4(?r3, ?r2)]);
		reach16(?r, ?r2) = (exists_{?r3 : robot} [reach8(?r, ?r3) ^ reach8(?r3, ?r2)]);
		reach32(?r, ?r2) = (exists_{?r3 : robot} [reach16(?r, ?r3) ^ reach16(?r3, ?r2)]);
		reach64(?r, ?r2) = (exists_{?r3 : robot} [reach32(?r, ?r3) ^ reach32(?r3, ?r2)]);

		// 2. loops of robots, and pairs swapping cells
		loop(?r) = (exists_{?r2 : robot} [next(?r, ?r2) ^ reach64(?r2, ?r)]);
		swap(?r) = (exists_{?r2 : robot} [next(?r, ?r2) ^ next(?r2, ?r)]);

		// 3. the longest line wins a free cell: the length of the longest line up to a robot
		// counts the robots from its far end, and at each cell where lines join, the robot
		// with the longest line behind it goes first
		length(?r) = (max_{?r2 : robot} [if (reach64(?r2, ?r))
										 then (sum_{?r3 : robot} [reach64(?r2, ?r3) ^ reach64(?r3, ?r)])
										 else 0]);
		first(?r) = ~(exists_{?r2 : robot} [
						moving(?r2) ^ (?r2 ~= ?r) ^ (aim-x(?r2) == aim-x(?r)) ^ (aim-y(?r2) == aim-y(?r))
						^ ((length(?r2) > length(?r))
						   | ((length(?r2) == length(?r))
							  ^ (WIDTH * robot-y(?r2) + robot-x(?r2) < WIDTH * robot-y(?r) + robot-x(?r))))]);

		// 1. a robot that is not moving, or is on a loop, ends the line of the robots behind it,
		// which do not move; the others move if every robot in front of them wins its cell
		advances(?r) = moving(?r)
					   ^ ((loop(?r) ^ ~swap(?r))
						  | (~(exists_{?r2 : robot} [reach64(?r, ?r2) ^ (~moving(?r2) | loop(?r2))])
							 ^ (forall_{?r2 : robot} [reach64(?r, ?r2) => first(?r2)])));

		// after the move: carried shelves move with their robots
		new-x(?r) = if (advances(?r)) then aim-x(?r) else robot-x(?r);
		new-y(?r) = if (advances(?r)) then aim-y(?r) else robot-y(?r);
		new-shelf-x(?s) = if (held(?s)) then (sum_{?r : robot} [if (carrying(?r, ?s)) then new-x(?r) else 0])
						  else shelf-x(?s);
		new-shelf-y(?s) = if (held(?s)) then (sum_{?r : robot} [if (carrying(?r, ?s)) then new-y(?r) else 0])
						  else shelf-y(?s);
		in-storage(?r) = (exists_{?x : xpos, ?y : ypos} [STORAGE(?x, ?y) ^ (X(?x) == robot-x(?r))
														 ^ (Y(?y) == robot-y(?r))]);
		delivered(?s) = requested(?s)
						^ (exists_{?x : xpos, ?y : ypos} [STATION(?x, ?y) ^ (X(?x) == new-shelf-x(?s))
														  ^ (Y(?y) == new-shelf-y(?s))]);

		// new requests replace the delivered ones
		draw(?s) = Uniform(0, 1);
		rank(?s) = (sum_{?s2 : shelf} [~requested(?s2) ^ (draw(?s2) < draw(?s))]);

		// the next state
		robot-x'(?r) = new-x(?r);
		robot-y'(?r) = new-y(?r);
		facing'(?r) = if (command(?r) == @turn-right) then
						 (if (facing(?r) == @up) then @right
						  else if (facing(?r) == @right) then @down
						  else if (facing(?r) == @down) then @left
						  else @up)
					  else if (command(?r) == @turn-left) then
						 (if (facing(?r) == @up) then @left
						  else if (facing(?r) == @left) then @down
						  else if (facing(?r) == @down) then @right
						  else @up)
					  else facing(?r);
		shelf-x'(?s) = new-shelf-x(?s);
		shelf-y'(?s) = new-shelf-y(?s);

		// lifting the shelf above a robot without a load, or putting down a load in storage
		carrying'(?r, ?s) = if (command(?r) ~= @toggle-load) then carrying(?r, ?s)
							else if (loaded(?r)) then carrying(?r, ?s) ^ ~in-storage(?r)
							else (shelf-x(?s) == robot-x(?r)) ^ (shelf-y(?s) == robot-y(?r));
		requested'(?s) = if (requested(?s)) then ~delivered(?s)
						 else (rank(?s) < (sum_{?s2 : shelf} [delivered(?s2)]));
	};

	reward = (sum_{?s : shelf} [delivered(?s)]);

	state-invariants {
		(sum_{?r : robot} [1]) <= 65;
	};
}
