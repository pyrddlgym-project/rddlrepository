// Instance 3 is a larger network in the setting of case study 2 of Van
// Roy et al. (not from the paper): 25 stores two, three or four days
// from the warehouse, with the production and warehouse capacities
// scaled with the number of stores. The system starts with 1150 goods
// at the warehouse, 22 at each store, and nothing on the road.

non-fluents retailer_inventory_nf3 {
	domain = retailer_inventory;

	objects {
		store : { s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25 };
		day : { d1, d2, d3, d4, d5 };
	};

	non-fluents {
		DAYS(d1) = 1;
		DAYS(d2) = 2;
		DAYS(d3) = 3;
		DAYS(d4) = 4;
		DAYS(d5) = 5;
		WAREHOUSE-DELAY = 5;
		PRODUCTION-CAPACITY = 250;
		WAREHOUSE-CAPACITY = 2500;
		WAIT-PROB = 0.8;
		SPECIAL-DELIVERY-COST = 0.0;
		WAREHOUSE-HOLDING-COST = 3.0;
		SHORTAGE-COST = 60.0;
		STORE-DELAY(s1) = 2;
		STORE-CAPACITY(s1) = 100;
		DEMAND-MEAN(s1) = 0.0;
		DEMAND-SD(s1) = 20.0;
