// IMP-MARL k-out-of-n benchmark struct_uc_3: 3 components, of which 2 must work,
// 30 years, discount 0.95, no campaign costs.

non-fluents structural_maintenance_nf0 {
	domain = structural_maintenance;

	objects {
		component : { c1, c2, c3 };
	};

	non-fluents {
		MIN-WORKING = 2;
	};
}

instance structural_maintenance_inst0 {
	domain = structural_maintenance;
	non-fluents = structural_maintenance_nf0;

	max-nondef-actions = pos-inf;
	horizon = 30;
	discount = 0.95;
}
