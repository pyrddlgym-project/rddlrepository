		ON(j6, s2, m4) = true;
		DURATION(j6, s2) = 3;
		ON(j6, s3, m6) = true;
		DURATION(j6, s3) = 9;
		ON(j6, s4, m1) = true;
		DURATION(j6, s4) = 10;
		ON(j6, s5, m5) = true;
		DURATION(j6, s5) = 4;
		ON(j6, s6, m3) = true;
		DURATION(j6, s6) = 1;
	};
}

instance job_shop_inst0 {
	domain = job_shop;
	non-fluents = job_shop_nf0;

	max-nondef-actions = pos-inf;
	horizon = 36;
	discount = 1.0;
}
