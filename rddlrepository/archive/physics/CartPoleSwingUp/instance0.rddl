// The pole starts hanging down, with the initial state of the DeepMind Control
// Suite cartpole swingup task after a reset: the cart position, the pole's offset
// from hanging down and both velocities are 0.01 times a standard normal. The
// episode lasts 10 s.

non-fluents cart_pole_swing_up_nf0 {
	domain = cart_pole_swing_up;
}

instance cart_pole_swing_up_inst0 {
	domain = cart_pole_swing_up;
	non-fluents = cart_pole_swing_up_nf0;

	init-state {
		pos = Normal(0.0, 0.0001);
		vel = Normal(0.0, 0.0001);
		ang = 3.14159265 + Normal(0.0, 0.0001);
		ang-vel = Normal(0.0, 0.0001);
	};

	max-nondef-actions = pos-inf;
	horizon = 1000;
	discount = 1.0;
}
