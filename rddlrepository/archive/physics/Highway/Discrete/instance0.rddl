// Two lanes and a few cars, over 20 seconds.
// The initial state is drawn as by highway-env 2.2.6 highway-v0 on every reset
// with lanes_count=2, vehicles_count=6 and vehicles_density=1.0,
// except the IDM exponents DELTA, which are non-fluents here and keep the
// values of reset(seed=11).

non-fluents highway_discrete_nf0 {
	domain = highway_discrete;

	objects {
		car : {ego, c1, c2, c3, c4, c5, c6};
	};

	non-fluents {
		NUM-LANES = 2;

		EGO(ego); ORDER(ego) = 0;
		ORDER(c1) = 1; DELTA(c1) = 3.647926084577456;
		ORDER(c2) = 2; DELTA(c2) = 4.448328453291775;
		ORDER(c3) = 3; DELTA(c3) = 4.011390021803263;
		ORDER(c4) = 4; DELTA(c4) = 4.288039594503992;
		ORDER(c5) = 5; DELTA(c5) = 4.316736435969658;
		ORDER(c6) = 6; DELTA(c6) = 4.0537303628652275;
	};
}

instance highway_discrete_inst0 {
	domain = highway_discrete;
	non-fluents = highway_discrete_nf0;

	init-state {
		target-lane(ego) = (floor[NUM-LANES * Uniform(0.0, 1.0)]); y(ego) = LANE-WIDTH * target-lane(ego); speed(ego) = 25.0; target-speed(ego) = 25.0;
		x(ego) = (3.0 + Uniform(0.9, 1.1)) * 2.0 * (12.0 + 25.0) * exp[-0.125 * NUM-LANES];
		target-lane(c1) = (floor[NUM-LANES * Uniform(0.0, 1.0)]); y(c1) = LANE-WIDTH * target-lane(c1);
		speed(c1) = Uniform(0.7 * SPEED-LIMIT, 0.8 * SPEED-LIMIT); target-speed(c1) = speed(c1);
		x(c1) = x(ego) + (12.0 + speed(c1)) / 1.0 * exp[-0.125 * NUM-LANES] * Uniform(0.9, 1.1);
		timer(c1) = fmod[(x(c1) + y(c1)) * 3.141592653589793, 1.0];
		target-lane(c2) = (floor[NUM-LANES * Uniform(0.0, 1.0)]); y(c2) = LANE-WIDTH * target-lane(c2);
		speed(c2) = Uniform(0.7 * SPEED-LIMIT, 0.8 * SPEED-LIMIT); target-speed(c2) = speed(c2);
		x(c2) = x(c1) + (12.0 + speed(c2)) / 1.0 * exp[-0.125 * NUM-LANES] * Uniform(0.9, 1.1);
		timer(c2) = fmod[(x(c2) + y(c2)) * 3.141592653589793, 1.0];
		target-lane(c3) = (floor[NUM-LANES * Uniform(0.0, 1.0)]); y(c3) = LANE-WIDTH * target-lane(c3);
		speed(c3) = Uniform(0.7 * SPEED-LIMIT, 0.8 * SPEED-LIMIT); target-speed(c3) = speed(c3);
		x(c3) = x(c2) + (12.0 + speed(c3)) / 1.0 * exp[-0.125 * NUM-LANES] * Uniform(0.9, 1.1);
		timer(c3) = fmod[(x(c3) + y(c3)) * 3.141592653589793, 1.0];
		target-lane(c4) = (floor[NUM-LANES * Uniform(0.0, 1.0)]); y(c4) = LANE-WIDTH * target-lane(c4);
		speed(c4) = Uniform(0.7 * SPEED-LIMIT, 0.8 * SPEED-LIMIT); target-speed(c4) = speed(c4);
		x(c4) = x(c3) + (12.0 + speed(c4)) / 1.0 * exp[-0.125 * NUM-LANES] * Uniform(0.9, 1.1);
		timer(c4) = fmod[(x(c4) + y(c4)) * 3.141592653589793, 1.0];
		target-lane(c5) = (floor[NUM-LANES * Uniform(0.0, 1.0)]); y(c5) = LANE-WIDTH * target-lane(c5);
		speed(c5) = Uniform(0.7 * SPEED-LIMIT, 0.8 * SPEED-LIMIT); target-speed(c5) = speed(c5);
		x(c5) = x(c4) + (12.0 + speed(c5)) / 1.0 * exp[-0.125 * NUM-LANES] * Uniform(0.9, 1.1);
		timer(c5) = fmod[(x(c5) + y(c5)) * 3.141592653589793, 1.0];
		target-lane(c6) = (floor[NUM-LANES * Uniform(0.0, 1.0)]); y(c6) = LANE-WIDTH * target-lane(c6);
		speed(c6) = Uniform(0.7 * SPEED-LIMIT, 0.8 * SPEED-LIMIT); target-speed(c6) = speed(c6);
		x(c6) = x(c5) + (12.0 + speed(c6)) / 1.0 * exp[-0.125 * NUM-LANES] * Uniform(0.9, 1.1);
		timer(c6) = fmod[(x(c6) + y(c6)) * 3.141592653589793, 1.0];
	};

	max-nondef-actions = pos-inf;
	horizon = 300;
	discount = 1.0;
}
