// Three lanes, as in highway-fast-v0, over 30 seconds.
// The initial state is drawn as by highway-env 2.2.6 highway-v0 on every reset
// with lanes_count=3, vehicles_count=20 and vehicles_density=1.0,
// except the IDM exponents DELTA, which are non-fluents here and keep the
// values of reset(seed=12).

non-fluents highway_discrete_nf1 {
	domain = highway_discrete;

	objects {
		car : {ego, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20};
	};

	non-fluents {
		NUM-LANES = 3;

		EGO(ego); ORDER(ego) = 0;
		ORDER(c1) = 1; DELTA(c1) = 3.8498892405959575;
		ORDER(c2) = 2; DELTA(c2) = 4.39630937370468;
		ORDER(c3) = 3; DELTA(c3) = 4.041466161718795;
		ORDER(c4) = 4; DELTA(c4) = 3.9536161218532766;
		ORDER(c5) = 5; DELTA(c5) = 3.7587710894221504;
		ORDER(c6) = 6; DELTA(c6) = 4.422810875443751;
		ORDER(c7) = 7; DELTA(c7) = 4.436696124929133;
		ORDER(c8) = 8; DELTA(c8) = 3.7193899345083383;
		ORDER(c9) = 9; DELTA(c9) = 4.278840092022072;
		ORDER(c10) = 10; DELTA(c10) = 3.5202287237100864;
		ORDER(c11) = 11; DELTA(c11) = 4.100110285529601;
		ORDER(c12) = 12; DELTA(c12) = 4.280382801293105;
		ORDER(c13) = 13; DELTA(c13) = 4.100284787567054;
		ORDER(c14) = 14; DELTA(c14) = 4.406083870149576;
		ORDER(c15) = 15; DELTA(c15) = 4.446968204727187;
		ORDER(c16) = 16; DELTA(c16) = 4.243249975336401;
		ORDER(c17) = 17; DELTA(c17) = 4.398157197508679;
		ORDER(c18) = 18; DELTA(c18) = 4.116476821940209;
		ORDER(c19) = 19; DELTA(c19) = 4.418663926218991;
		ORDER(c20) = 20; DELTA(c20) = 4.263402163780221;
	};
}

instance highway_discrete_inst1 {
	domain = highway_discrete;
	non-fluents = highway_discrete_nf1;

	init-state {
		target-lane(ego) = (floor[NUM-LANES * Uniform(0.0, 1.0)]); y(ego) = LANE-WIDTH * target-lane(ego); speed(ego) = 25.0; target-speed(ego) = 25.0;
		x(ego) = (3.0 + Uniform(0.9, 1.1)) * 2.0 * (12.0 + 25.0) * exp[-0.125 * NUM-LANES];
		target-lane(c1) = (floor[NUM-LANES * Uniform(0.0, 1.0)]); y(c1) = LANE-WIDTH * target-lane(c1);
		speed(c1) = Uniform(0.7 * SPEED-LIMIT, 0.8 * SPEED-LIMIT); target-speed(c1) = speed(c1);
		x(c1) = x(ego) + (12.0 + speed(c1)) / 1.0 * exp[-0.125 * NUM-LANES] * Uniform(0.9, 1.1);
		timer(c1) = fmod[(x(c1) + y(c1)) * 3.141592653589793, 1.0];
		target-lane(c2) = (floor[NUM-LANES * Uniform(0.0, 1.0)]); y(c2) = LANE-WIDTH * target-lane(c2);
		speed(c2) = Uniform(0.7 * SPEED-LIMIT, 0.8 * SPEED-LIMIT); target-speed(c2) = speed(c2);
		x(c2) = x(c1) + (12.0 + speed(c2)) / 1.0 * exp[-0.125 * NUM-LANES] * Uniform(0.9, 1.1);
