		x(c5) = x(c4) + (12.0 + speed(c5)) / 1.0 * exp[-0.125 * NUM-LANES] * Uniform(0.9, 1.1);
		timer(c5) = fmod[(x(c5) + y(c5)) * 3.141592653589793, 1.0];
