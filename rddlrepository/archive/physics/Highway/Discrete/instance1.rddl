		target-lane(c15) = (floor[NUM-LANES * Uniform(0.0, 1.0)]); y(c15) = LANE-WIDTH * target-lane(c15);
		speed(c15) = Uniform(0.7 * SPEED-LIMIT, 0.8 * SPEED-LIMIT); target-speed(c15) = speed(c15);
