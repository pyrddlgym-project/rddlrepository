		timer(c15) = fmod[(x(c15) + y(c15)) * 3.141592653589793, 1.0];
		target-lane(c16) = (floor[NUM-LANES * Uniform(0.0, 1.0)]); y(c16) = LANE-WIDTH * target-lane(c16);
		speed(c16) = Uniform(0.7 * SPEED-LIMIT, 0.8 * SPEED-LIMIT); target-speed(c16) = speed(c16);
		x(c16) = x(c15) + (12.0 + speed(c16)) / 1.0 * exp[-0.125 * NUM-LANES] * Uniform(0.9, 1.1);
		timer(c16) = fmod[(x(c16) + y(c16)) * 3.141592653589793, 1.0];
