// Four lanes and 50 cars in denser traffic, over 40 seconds.
// The initial state is drawn as by highway-env 2.2.6 highway-v0 on every reset
// with lanes_count=4, vehicles_count=50 and vehicles_density=1.5,
// except the IDM exponents DELTA, which are non-fluents here and keep the
// values of reset(seed=14).

non-fluents highway_discrete_nf3 {
	domain = highway_discrete;

	objects {
		car : {ego, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29, c30, c31, c32, c33, c34, c35, c36, c37, c38, c39, c40, c41, c42, c43, c44, c45, c46, c47, c48, c49, c50};
