non-fluents lander_continuous_nf0 {
	domain = lander_continuous;

	objects {
		point : {p0, p1, p2, p3};
		probe : {left_leg, right_leg, hull_lower_left, hull_lower_right, hull_upper_left, hull_upper_right};
	};

	non-fluents {
		// a flat plain with the pad in the middle
		X(p0) = -8.0; Y(p0) = 0.0;
		X(p1) = -2.0; Y(p1) = 0.0;
		X(p2) = 2.0; Y(p2) = 0.0;
		X(p3) = 8.0; Y(p3) = 0.0;
		NEXT(p0, p1);
		NEXT(p1, p2);
		NEXT(p2, p3);
		PAD(p1, p2);

		// the body
		PX(left_leg) = -0.5; PY(left_leg) = -0.5; IS-LEG(left_leg);
		PX(right_leg) = 0.5; PY(right_leg) = -0.5; IS-LEG(right_leg);
		PX(hull_lower_left) = -0.35; PY(hull_lower_left) = -0.3;
		PX(hull_lower_right) = 0.35; PY(hull_lower_right) = -0.3;
		PX(hull_upper_left) = -0.35; PY(hull_upper_left) = 0.3;
		PX(hull_upper_right) = 0.35; PY(hull_upper_right) = 0.3;
	};
}

instance lander_continuous_inst0 {
	domain = lander_continuous;
	non-fluents = lander_continuous_nf0;

	init-state {
		x = 3.0;
		y = 5.0;
	};

	max-nondef-actions = pos-inf;
	horizon = 500;
	discount = 1.0;
}
