// The deputy starts 100 to 150 m from the chief, drifting, with the random initial
// state of the AFRL 3D docking environment. The spherical coordinates of the position
// and velocity are drawn through dist (the distance) and excess (the speed minus the
// speed limit), and each Cartesian component in turn given the ones before it. The
// horizon leaves room for the timeout, which ends the episode after step 2001.

non-fluents spacecraft_docking_nf0 {
	domain = spacecraft_docking;
}

instance spacecraft_docking_inst0 {
	domain = spacecraft_docking;
	non-fluents = spacecraft_docking_nf0;

	init-state {
		dist = Uniform(100.0, 150.0);
		z = dist * cos[Uniform(0.0, 3.14159265)];
		x = sqrt[max[0.0, pow[dist, 2] - pow[z, 2]]] * cos[Uniform(0.0, 6.2831853)];
		y = (if (Bernoulli(0.5)) then 1.0 else -1.0) * sqrt[max[0.0, pow[dist, 2] - pow[z, 2] - pow[x, 2]]];
		excess = Uniform(0.0, min[SPEED-LIMIT-MIN + SPEED-LIMIT-SLOPE * MEAN-MOTION * dist, 10.0])
			- (SPEED-LIMIT-MIN + SPEED-LIMIT-SLOPE * MEAN-MOTION * max[0.0, dist - DOCK-RADIUS]);
		vz = (excess + SPEED-LIMIT-MIN + SPEED-LIMIT-SLOPE * MEAN-MOTION * max[0.0, dist - DOCK-RADIUS])
			* cos[Uniform(0.0, 3.14159265)];
		vx = sqrt[max[0.0, pow[excess + SPEED-LIMIT-MIN + SPEED-LIMIT-SLOPE * MEAN-MOTION * max[0.0, dist - DOCK-RADIUS], 2]
			- pow[vz, 2]]] * cos[Uniform(0.0, 6.2831853)];
		vy = (if (Bernoulli(0.5)) then 1.0 else -1.0)
			* sqrt[max[0.0, pow[excess + SPEED-LIMIT-MIN + SPEED-LIMIT-SLOPE * MEAN-MOTION * max[0.0, dist - DOCK-RADIUS], 2]
			- pow[vz, 2] - pow[vx, 2]]];
	};

	max-nondef-actions = pos-inf;
	horizon = 2001;
	discount = 1.0;
}
