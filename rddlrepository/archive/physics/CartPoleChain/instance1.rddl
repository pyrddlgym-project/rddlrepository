// The control suite three_poles task: 3 poles hanging down, with the initial state of a reset:
// the cart position and velocity are 0.01 times a standard normal, the first hinge is hanging
// down plus 0.01, and each other hinge 0.1, times a standard normal, and each hinge velocity is
// 0.01 times a standard normal (summed into absolute angles and velocities). The episode
// lasts 10 s.

non-fluents cart_pole_chain_nf1 {
	domain = cart_pole_chain;

	objects {
		pole : { p1, p2, p3 };
	};

	non-fluents {
		INDEX(p1) = 1;
		INDEX(p2) = 2;
		INDEX(p3) = 3;
	};
}

instance cart_pole_chain_inst1 {
	domain = cart_pole_chain;
	non-fluents = cart_pole_chain_nf1;

	init-state {
		pos = Normal(0.0, 0.0001);
		vel = Normal(0.0, 0.0001);
		ang(p1) = 3.14159265 + Normal(0.0, 0.0001);
		ang(p2) = ang(p1) + Normal(0.0, 0.01);
		ang(p3) = ang(p2) + Normal(0.0, 0.01);
		ang-vel(p1) = Normal(0.0, 0.0001);
		ang-vel(p2) = ang-vel(p1) + Normal(0.0, 0.0001);
		ang-vel(p3) = ang-vel(p2) + Normal(0.0, 0.0001);
	};

	max-nondef-actions = pos-inf;
	horizon = 1000;
	discount = 1.0;
}
