// The control suite two_poles task: 2 poles hanging down, with the initial state of a reset
// with random=0 (the poles' hinge angles and velocities summed into absolute ones). The
// episode lasts 10 s.

non-fluents cart_pole_chain_nf0 {
	domain = cart_pole_chain;

	objects {
		pole : { p1, p2 };
	};

	non-fluents {
		INDEX(p1) = 1;
		INDEX(p2) = 2;
	};
}

instance cart_pole_chain_inst0 {
	domain = cart_pole_chain;
	non-fluents = cart_pole_chain_nf0;

	init-state {
		pos = 0.017640523459676642;
		vel = 0.022408931992014578;
		ang(p1) = 3.1455942256734652;
		ang(p2) = 3.2434680240840392;
		ang-vel(p1) = 0.018675579901499675;
		ang-vel(p2) = 0.008902801102735565;
	};

	max-nondef-actions = pos-inf;
	horizon = 1000;
	discount = 1.0;
}
