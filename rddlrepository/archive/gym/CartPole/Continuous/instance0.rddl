non-fluents cart_pole_con_0 {
    domain = cart_pole_continuous;
}

instance inst_cart_pole_con_0 {

	domain = cart_pole_continuous;

	non-fluents = cart_pole_con_0;

	init-state {
		pos = Uniform(-0.05, 0.05);
		vel = Uniform(-0.05, 0.05);
		ang-pos = Uniform(-0.05, 0.05);
		ang-vel = Uniform(-0.05, 0.05);
	};

	max-nondef-actions = pos-inf;
	horizon  = 200;
	discount = 1.0;
}

