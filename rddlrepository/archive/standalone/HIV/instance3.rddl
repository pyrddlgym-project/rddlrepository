// Four patients: two in the non-healthy steady state, one just infected, and one in the healthy
// steady state, who needs no drugs; 1000 days in steps of 0.1 day.

non-fluents hiv_nf3 {
	domain = hiv;

	objects {
		patient : { p1, p2, p3, p4 };
	};
}

instance hiv_inst3 {
	domain = hiv;
	non-fluents = hiv_nf3;

	init-state {
		t1(p1) = 163573;
		t2(p1) = 5;
		i1(p1) = 11945;
		i2(p1) = 46;
		v(p1) = 63919;
		e(p1) = 24;
		t1(p2) = 163573;
		t2(p2) = 5;
		i1(p2) = 11945;
		i2(p2) = 46;
		v(p2) = 63919;
		e(p2) = 24;
		v(p3) = 1;
		t1(p4) = 967839;
		t2(p4) = 621;
		i1(p4) = 76;
		i2(p4) = 6;
		v(p4) = 415;
		e(p4) = 353108;
	};

	max-nondef-actions = pos-inf;
	horizon = 10000;
	discount = 0.9995960275;	// 0.98 per revision, as in Ernst et al.
}
