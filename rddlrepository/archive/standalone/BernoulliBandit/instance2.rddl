// Instance 2 has 25 arms whose prior means are between 0.2 and 0.6 and
// whose priors are worth 2 to 200 pulls, drawn at random, and fewer
// pulls than needed to learn every arm well. In simulation a greedy
// policy wins about 94, Thompson sampling 103 and the online knowledge
// gradient 108; knowing the true probabilities would win 121.

non-fluents bernoulli_bandit_nf2 {
	domain = bernoulli_bandit;

	objects {
		arm : { a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24, a25 };
	};
}

instance bernoulli_bandit_inst2 {
