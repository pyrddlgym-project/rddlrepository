////////////////////////////////////////////////////////////////////
// The Bayesian Bernoulli bandit, as a Bayes-adaptive MDP. Each arm
// succeeds with an unknown probability, believed to follow a Beta
// distribution with parameters alpha and beta. These are the state:
// the initial state is the prior, and pulling an arm adds 1 to alpha
// on a success or to beta on a failure, so the state is the posterior.
// Each step pulls one arm, and the reward is 1 on a success.
//
// There is no true probability in the model, which a planner could
// read. A pulled arm instead succeeds with the probability that the
// current belief gives it, alpha / (alpha + beta). The successes then
// follow exactly the distribution they would have if each arm's
// probability were drawn from the prior at the start of an episode
// and then held fixed (Polya's urn), so each episode has its own true
// probabilities, which nobody sees. A good policy must therefore
// trade pulling the arm that looks best against learning about the
// others. With a discount below 1 and an infinite horizon, the optimal
// policy pulls the arm of highest Gittins index.
//
// References:
//
//		John C. Gittins. Bandit processes and dynamic allocation indices.
//		Journal of the Royal Statistical Society B 41(2), 148-177, 1979.
//
//		Donald A. Berry and Bert Fristedt. Bandit Problems: Sequential
//		Allocation of Experiments. Chapman and Hall, 1985.
//
//		Michael O. Duff. Optimal learning: computational procedures for
//		Bayes-adaptive Markov decision processes. PhD thesis, University
//		of Massachusetts Amherst, 2002.
//
////////////////////////////////////////////////////////////////////
domain bernoulli_bandit {

	requirements = {
		constrained-state
	};

	types {
		arm : object;
	};

	pvariables {

		// the belief about the arm's probability of success, Beta(alpha, beta)
		alpha(arm) 		: { state-fluent, real, default = 1.0 };	// prior plus successes
		beta(arm) 		: { state-fluent, real, default = 1.0 };	// prior plus failures

		outcome(arm) 	: { interm-fluent, bool };					// the pulled arm succeeds

		pull(arm) 		: { action-fluent, bool, default = false };
	};

	cpfs {

		// a success with the probability the current belief gives it
		outcome(?a) = if (pull(?a)) then Bernoulli(alpha(?a) / (alpha(?a) + beta(?a))) else false;

		alpha'(?a) = alpha(?a) + (if (pull(?a) ^ outcome(?a)) then 1.0 else 0.0);
		beta'(?a) = beta(?a) + (if (pull(?a) ^ ~outcome(?a)) then 1.0 else 0.0);
	};

	reward = (sum_{?a : arm} [if (outcome(?a)) then 1.0 else 0.0]);

	action-preconditions {
		(sum_{?a : arm} [pull(?a)]) == 1;
	};

	// the prior is a Beta distribution
	state-invariants {
		forall_{?a : arm} [(alpha(?a) > 0) ^ (beta(?a) > 0)];
	};
}
