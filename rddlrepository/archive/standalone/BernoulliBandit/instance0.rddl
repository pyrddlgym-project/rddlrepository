// Instance 0 has two arms: an established one, believed to succeed
// with probability about 0.6 (as after 50 pulls), and a new one
// believed worse on average (0.4) but uncertain (as after 2.5 pulls).
// A greedy policy never tries the new arm and wins 30 in expectation;
// the Bayes-optimal policy, computed exactly by backward induction,
// wins 31.08. Thompson sampling and the online knowledge gradient win
// about 30.2.

non-fluents bernoulli_bandit_nf0 {
	domain = bernoulli_bandit;

	objects {
		arm : { old, new };
	};
}

instance bernoulli_bandit_inst0 {
	domain = bernoulli_bandit;
	non-fluents = bernoulli_bandit_nf0;

	init-state {
		alpha(old) = 30.0;	beta(old) = 20.0;
		alpha(new) = 1.0;	beta(new) = 1.5;
	};

	max-nondef-actions = 1;
	horizon = 50;
	discount = 1.0;
}
