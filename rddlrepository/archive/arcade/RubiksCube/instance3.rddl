// The Rubik's cube (3 x 3 x 3), scrambled by 100 random moves, as in Jumanji.

non-fluents rubiks_cube_nf3 {
	domain = rubiks_cube;

	objects {
		sticker : { up_0_0, up_1_0, up_2_0, up_0_1, up_1_1, up_2_1, up_0_2, up_1_2, up_2_2, front_2_0, front_1_0, front_0_0, front_2_1, front_1_1, front_0_1, front_2_2, front_1_2, front_0_2, right_2_2, right_2_1, right_2_0, right_1_2, right_1_1, right_1_0, right_0_2, right_0_1, right_0_0, back_2_2, back_1_2, back_0_2, back_2_1, back_1_1, back_0_1, back_2_0, back_1_0, back_0_0, left_2_0, left_2_1, left_2_2, left_1_0, left_1_1, left_1_2, left_0_0, left_0_1, left_0_2, down_2_0, down_1_0, down_0_0, down_2_1, down_1_1, down_0_1, down_2_2, down_1_2, down_0_2 };
	};

	non-fluents {
		SIZE = 3;
		COLOR(up_0_0) = @white; COLOR(up_1_0) = @white; COLOR(up_2_0) = @white; COLOR(up_0_1) = @white; COLOR(up_1_1) = @white; COLOR(up_2_1) = @white; COLOR(up_0_2) = @white; COLOR(up_1_2) = @white; COLOR(up_2_2) = @white;
		COLOR(front_2_0) = @green; COLOR(front_1_0) = @green; COLOR(front_0_0) = @green; COLOR(front_2_1) = @green; COLOR(front_1_1) = @green; COLOR(front_0_1) = @green; COLOR(front_2_2) = @green; COLOR(front_1_2) = @green; COLOR(front_0_2) = @green;
		COLOR(right_2_2) = @red; COLOR(right_2_1) = @red; COLOR(right_2_0) = @red; COLOR(right_1_2) = @red; COLOR(right_1_1) = @red; COLOR(right_1_0) = @red; COLOR(right_0_2) = @red; COLOR(right_0_1) = @red; COLOR(right_0_0) = @red;
		COLOR(back_2_2) = @blue; COLOR(back_1_2) = @blue; COLOR(back_0_2) = @blue; COLOR(back_2_1) = @blue; COLOR(back_1_1) = @blue; COLOR(back_0_1) = @blue; COLOR(back_2_0) = @blue; COLOR(back_1_0) = @blue; COLOR(back_0_0) = @blue;
		COLOR(left_2_0) = @orange; COLOR(left_2_1) = @orange; COLOR(left_2_2) = @orange; COLOR(left_1_0) = @orange; COLOR(left_1_1) = @orange; COLOR(left_1_2) = @orange; COLOR(left_0_0) = @orange; COLOR(left_0_1) = @orange; COLOR(left_0_2) = @orange;
		COLOR(down_2_0) = @yellow; COLOR(down_1_0) = @yellow; COLOR(down_0_0) = @yellow; COLOR(down_2_1) = @yellow; COLOR(down_1_1) = @yellow; COLOR(down_0_1) = @yellow; COLOR(down_2_2) = @yellow; COLOR(down_1_2) = @yellow; COLOR(down_0_2) = @yellow;
	};
}

