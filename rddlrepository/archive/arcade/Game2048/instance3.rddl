// A board of 6 x 6 cells, starting with a 2 in column 2 of row 3.

non-fluents game_2048_nf3 {
	domain = game_2048;

	objects {
		xpos : { x0, x1, x2, x3, x4, x5 };
		ypos : { y0, y1, y2, y3, y4, y5 };
	};

	non-fluents {
		WIDTH = 6;
		HEIGHT = 6;
		X(x0) = 0; X(x1) = 1; X(x2) = 2; X(x3) = 3; X(x4) = 4; X(x5) = 5;
		Y(y0) = 0; Y(y1) = 1; Y(y2) = 2; Y(y3) = 3; Y(y4) = 4; Y(y5) = 5;
	};
}

instance game_2048_inst3 {
	domain = game_2048;
	non-fluents = game_2048_nf3;

	init-state {
		tile(x2, y3) = 1;
	};

	max-nondef-actions = pos-inf;
	horizon = 2000;
	discount = 1.0;
}
