// A small board of 3 x 3 cells, starting with a 2 in the middle.

non-fluents game_2048_nf1 {
	domain = game_2048;

	objects {
		xpos : { x0, x1, x2 };
		ypos : { y0, y1, y2 };
	};

	non-fluents {
		WIDTH = 3;
		HEIGHT = 3;
		X(x0) = 0; X(x1) = 1; X(x2) = 2;
		Y(y0) = 0; Y(y1) = 1; Y(y2) = 2;
	};
}

instance game_2048_inst1 {
	domain = game_2048;
	non-fluents = game_2048_nf1;

	init-state {
		tile(x1, y1) = 1;
	};

	max-nondef-actions = pos-inf;
	horizon = 2000;
	discount = 1.0;
}
