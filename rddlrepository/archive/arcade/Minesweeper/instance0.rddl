// The default board of Jumanji: 10 x 10 cells with 10 mines.

non-fluents minesweeper_nf0 {
	domain = minesweeper;

	objects {
		xpos : { x0, x1, x2, x3, x4, x5, x6, x7, x8, x9 };
		ypos : { y0, y1, y2, y3, y4, y5, y6, y7, y8, y9 };
	};

	non-fluents {
		WIDTH = 10;
		HEIGHT = 10;
		MINES = 10;
		X(x0) = 0; X(x1) = 1; X(x2) = 2; X(x3) = 3; X(x4) = 4; X(x5) = 5; X(x6) = 6; X(x7) = 7; X(x8) = 8; X(x9) = 9;
		Y(y0) = 0; Y(y1) = 1; Y(y2) = 2; Y(y3) = 3; Y(y4) = 4; Y(y5) = 5; Y(y6) = 6; Y(y7) = 7; Y(y8) = 8; Y(y9) = 9;
	};
}

instance minesweeper_inst0 {
	domain = minesweeper;
	non-fluents = minesweeper_nf0;

	max-nondef-actions = 1;
	horizon = 90;
	discount = 1.0;
}
