// The grid of Jumanji: 12 x 12 cells, with a snake of length 1 in column 5
// of row 6 and the first fruit in column 9 of row 2.

non-fluents snake_nf0 {
	domain = snake;

	objects {
		xpos : { x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11 };
		ypos : { y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11 };
	};

	non-fluents {
		WIDTH = 12;
		HEIGHT = 12;
		X(x0) = 0; X(x1) = 1; X(x2) = 2; X(x3) = 3; X(x4) = 4; X(x5) = 5; X(x6) = 6; X(x7) = 7; X(x8) = 8; X(x9) = 9; X(x10) = 10; X(x11) = 11;
		Y(y0) = 0; Y(y1) = 1; Y(y2) = 2; Y(y3) = 3; Y(y4) = 4; Y(y5) = 5; Y(y6) = 6; Y(y7) = 7; Y(y8) = 8; Y(y9) = 9; Y(y10) = 10; Y(y11) = 11;
	};
}

instance snake_inst0 {
	domain = snake;
	non-fluents = snake_nf0;

	init-state {
		head-x = 5;
		head-y = 6;
		age(x5, y6) = 1;
		fruit(x9, y2) = true;
	};

	max-nondef-actions = pos-inf;
	horizon = 4000;
	discount = 1.0;
}
