// Case 2 of Walters and Hilborn (their Figure 4): an old fishery that has
// held its stock low for years, so it knows the production alpha = 1.5
// (the middle column) but not the density dependence beta. The prior on
// beta is Normal(1.2, 0.4) (the middle row, at the end of their range of
// estimates), the environmental variance 0.5, the stock starts at 0.5 and
// the spawning grounds hold 2 (the stocks of their dynamic program reach
// 2). The prior gives beta <= 0 a probability of 0.03.
//
// Over 50 generations with the discount of 4% per generation, catching
// half of every run earns about 25.2, the usual policy (the best fixed
// escapement for the current estimates, and all fish in the last
// generation) about 38.1, and the best fixed escapement for the true
// curve, which no policy can know, about 41 (means of 1000 simulated
// episodes).

non-fluents adaptive_fishery_nf1 {
	domain = adaptive_fishery;

	objects {
		stock : { sockeye };
	};

	non-fluents {
		NOISE-VAR(sockeye) = 0.5;
		SPAWNING-CAPACITY(sockeye) = 2.0;
	};
}

instance adaptive_fishery_inst1 {
	domain = adaptive_fishery;
	non-fluents = adaptive_fishery_nf1;

	init-state {
		recruits(sockeye) = 0.5;
		alpha-hat(sockeye) = 1.5;
		beta-hat(sockeye) = 1.2;
		var-alpha(sockeye) = 0.0;
		var-beta(sockeye) = 0.4;
		cov-alpha-beta(sockeye) = 0.0;
	};

	max-nondef-actions = pos-inf;
	horizon = 50;
	discount = 0.960789;
}
