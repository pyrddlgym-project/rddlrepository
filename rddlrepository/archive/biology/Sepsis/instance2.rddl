// Ten patients admitted at random, as in Oberst and Sontag (2019), each treated for at most 20
// steps; the horizon leaves room for the draws rejected at admission.

non-fluents sepsis_nf2 {
	domain = sepsis;

	objects {
		patient : { p1, p2, p3, p4, p5, p6, p7, p8, p9, p10 };
	};
}

instance sepsis_inst2 {
	domain = sepsis;
	non-fluents = sepsis_nf2;

	max-nondef-actions = pos-inf;
	horizon = 30;
	discount = 0.99;	// as the paper computes its policies
}
