// Thirty patients admitted at random, as in Oberst and Sontag (2019), each treated for at most 20
// steps; the horizon leaves room for the draws rejected at admission.

non-fluents sepsis_nf4 {
	domain = sepsis;

	objects {
		patient : { p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15, p16, p17, p18, p19, p20, p21, p22, p23, p24, p25, p26, p27, p28, p29, p30 };
	};
}

instance sepsis_inst4 {
	domain = sepsis;
	non-fluents = sepsis_nf4;

	max-nondef-actions = pos-inf;
	horizon = 30;
	discount = 0.99;	// as the paper computes its policies
}
