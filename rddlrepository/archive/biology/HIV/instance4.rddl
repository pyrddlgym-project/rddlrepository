// Ten patients: six in the non-healthy steady state, two just infected, and two in the healthy
// steady state; 1000 days in steps of 0.1 day.

non-fluents hiv_nf4 {
	domain = hiv;

	objects {
		patient : { p1, p2, p3, p4, p5, p6, p7, p8, p9, p10 };
	};
}

instance hiv_inst4 {
	domain = hiv;
	non-fluents = hiv_nf4;

